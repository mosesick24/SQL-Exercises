--Question 01: Retrieve all columns from the employees table

SELECT * FROM sorting.default.employees;

--Question 02: Find all unique departments

SELECT DISTINCT department FROM sorting.default.employees;
--Question 03: Retrive first and last names ordered by salary desc

SELECT first_name, last_name FROM sorting.default.employees ORDER BY salary DESC;

--Question 04: Retrieve the top 3 highest-paid employees

SELECT employee_id, first_name, last_name, salary FROM sorting.default.employees ORDER BY salary DESC LIMIT 3;

--Question 05: Find employees in the IT department

SELECT employee_id, first_name, last_name,department FROM sorting.default.employees WHERE department = 'IT';

--Question 06: Find employees in finance with salary > 60000

SELECT employee_id , first_name, last_name, department, salary FROM sorting.default.employees WHERE department = 'FINANCE' AND salary > 60000;

--Question 07: Find employees in HR or Marketing

SELECT employee_id, first_name, last_name, department FROM sorting.default.employees WHERE department = 'HR' OR department ='Marketing';


--Question 08: Find employees not in IT

SELECT employee_id, first_name, last_name, department FROM sorting.default.employees WHERE department <> 'IT';

--Question 09:Find employees in IT, HR, or Finance using IN

SELECT employee_id, first_name, last_name, department FROM sorting.default.employees WHERE department IN ('IT','HR','FINANCE');

--Question 10: Find employees in IT with salary > 65000 and city Johannesburg

SELECT employee_id, first_name, last_name, department, salary,city FROM sorting.default.employees WHERE department = 'IT' AND salary > 65000 AND city = 'Johannesburg';


