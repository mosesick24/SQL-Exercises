--Question 03:Categorize each employee's position level using both department and salary.If in 'IT' and salary > 80000 → 'Senior IT' If in 'HR' and salary > 55000 → 'Experienced HR' Otherwise → 'Staff' :: emp_name department salary position_level

SELECT emp_name, department, salary,
CASE WHEN department = 'IT' AND salary > 80000 THEN 'Senior IT' WHEN department = 'HR' AND salary > 55000 THEN 'Experienced HR'
ELSE 'Staff'
END AS position_level
FROM ringers.lactate.employees;

