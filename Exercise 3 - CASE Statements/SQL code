--Question 02: Label each order by its value.'High Value' for orders ≥ 1000'Medium Value' for 500–999.99'Low Value' for orders < 500 : customer_name amount order_value_category
SELECT customer_name, amount, CASE WHEN amount >= 1000 THEN 'High Value' WHEN amount BETWEEN 500 AND 999.99 THEN 'Medium Value' ELSE 'Low Value' END AS order_value_category FROM fullergood.honey.orders;

