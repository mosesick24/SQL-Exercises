--QUESTION 05: Label delivery performance based on the time taken.
--<= 30 mins → 'Fast' 31–60 mins → 'On Time' > 60 mins → 'Late' E X P E C T E D C O L U M N S : delivery_id delivery_time_minutes performance

SELECT delivery_id, delivery_time_minutes, 
CASE WHEN delivery_time_minutes <= 30 THEN 'Fast'
     WHEN delivery_time_minutes BETWEEN 31 AND 60 THEN 'On Time' 
     WHEN delivery_time_minutes > 60 THEN 'Late' END AS performance FROM province.welkom.deliveries;

