--Question 04: Assign each student a letter grade based on their score ≥ 90 → 'A' 80–89 → 'B' 70–79 → 'C' 60–69 → 'D' < 60 → 'F'

SELECT student_name, score, CASE WHEN score >= 90 THEN 'A'
WHEN   score BETWEEN 80 AND 89 THEN 'B'
WHEN score BETWEEN 70 AND 79 THEN 'C'
WHEN score BETWEEN 60 AND 69 THEN 'D'
WHEN score < 60 THEN 'F'
END AS grade FROM state.welkom.students;

