Create CATALOG if not exists bochum;
Create SCHEMA if not exists bochum.newstand;
Create TABLE if not exists bochum.newstand.salaries (employee_id int,name string,department string, salary int,bonus int);
INSERT INTO bochum.newstand.salaries VALUES (1,'Tom','IT',60000,5000),(2,'Jerry','HR',55000,4000),(3,'Spike','Finance',70000,6000),(4,'Tyke','IT',62000,5500),(5,'Butch','HR',54000,3500);

SELECT * FROM bochum.newstand.salaries;
--QUESTION 11:Find total salary and total bonus per department.
SELECT department, sum(salary) AS total_salary, sum(bonus) AS total_bonus FROM bochum.newstand.salaries GROUP BY department;

--Question 12:Show departments where average salary is above 55,000.
SELECT department, avg(salary) AS avg_salary FROM bochum.newstand.salaries GROUP BY department HAVING avg_salary> 55000;

--Question 13:List employees whose salary plus bonus is greater than 60,000.
SELECT employee_id,name,salary,bonus, sum(salary+bonus) AS total_compensation FROM bochum.newstand.salaries GROUP BY employee_id,name,salary,bonus HAVING total_compensation>60000;

