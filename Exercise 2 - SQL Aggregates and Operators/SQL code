Create CATALOG if not exists mohodi;
Create SCHEMA if not exists mohodi.fatima;
Create TABLE if not exists mohodi.fatima.enrollments (enrollment_id int,student_id int,course_id int,grade int);
INSERT INTO mohodi.fatima.enrollments VALUES (1,1,101,85),(2,2,102,78),(3,3,103,90),(4,4,104,88),(5,5,105,82);

SELECT * FROM mohodi.fatima.enrollments;
--Question 9:Get the maximum, minimum, and average grade across all enrollments
SELECT MAX(grade) AS max_grade,MIN(grade) AS min_grade, AVG(grade) AS avg_grade FROM mohodi.fatima.enrollments;

--Question 10: Count how many enrollments exist per course.
SELECT course_id,COUNT(enrollment_id) AS enrollment_count FROM mohodi.fatima.enrollments GROUP BY course_id;

