CREATE CATALOG IF NOT EXISTS BUCCLEUCH;
CREATE SCHEMA IF NOT EXISTS BUCCLEUCH.PRIMARY;
CREATE TABLE IF NOT EXISTS BUCCLEUCH.PRIMARY.LEARNERS (student_id INT, name STRING, age INT, department STRING);
INSERT INTO BUCCLEUCH.PRIMARY.LEARNERS VALUES (1, 'Alice', 20,'IT'), (2, 'Bob', 22, 'HR'), (3, 'Charlie', 21, 'IT'), (4, 'Diana', 23, 'Finance'), (5, 'Eve', 22, 'HR');

SELECT * FROM BUCCLEUCH.PRIMARY.LEARNERS;
--select distinct department from BUCCLEUCH.PRIMARY.LEARNERS
SELECT DISTINCT department FROM BUCCLEUCH.PRIMARY.LEARNERS;

--Get the average age of students per department
SELECT department, AVG (age) AS average_age FROM BUCCLEUCH.PRIMARY.LEARNERS GROUP BY department;

--Show departments with more than 1 student
SELECT department, COUNT (student_id) AS student_count FROM BUCCLEUCH.PRIMARY.LEARNERS GROUP BY department HAVING student_count > 1;

--Get all students whose age is between 21 and 23.
SELECT student_id, name, age, department FROM BUCCLEUCH.PRIMARY.LEARNERS WHERE age BETWEEN 21 AND 23;

--List all students in the IT or HR department who are older than 21.
SELECT student_id, name, age,department FROM BUCCLEUCH.PRIMARY.LEARNERS WHERE department IN ( 'IT', 'HR') AND age > 21;

--Question 6-8--

CREATE CATALOG IF NOT EXISTS SANDTON;
CREATE SCHEMA IF NOT EXISTS SANDTON.SUNNINGHILL;
CREATE TABLE IF NOT EXISTS SANDTON.SUNNINGHILL.COURSES (course_id INT, course_name STRING,department STRING, credits INT);

INSERT INTO  SANDTON.SUNNINGHILL.COURSES VALUES (101, 'SQL Basics','IT', 3), (102, 'Python','IT',4), (103, 'Data Science','IT',4), (104, 'Excel','Finance',2), (105, 'Statistics','HR',3);

SELECT* FROM SANDTON.SUNNINGHILL.COURSES;

--Question 6:Show total credits per department, only for departments with more than 5 total credits.
SELECT department, SUM(credits) AS total_credits FROM SANDTON.SUNNINGHILL.COURSES GROUP BY department HAVING total_credits > 5;

--Question 7:List all courses that do not have 4 credits.
SELECT course_id, course_name, department, credits FROM SANDTON.SUNNINGHILL.COURSES WHERE credits != 4;

--Question 8: Show the top 3 courses by credits in descending order.
SELECT course_id, course_name, credits FROM SANDTON.SUNNINGHILL.COURSES ORDER BY credits DESC LIMIT 3;

